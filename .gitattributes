# Normalize line endings to LF in the repo, checkout as-is on Windows
* text=auto

# Force LF for source files
*.java text eol=lf
*.py   text eol=lf
*.js   text eol=lf
*.jsx  text eol=lf
*.ts   text eol=lf
*.tsx  text eol=lf
*.yml  text eol=lf
*.yaml text eol=lf
*.xml  text eol=lf
*.json text eol=lf
*.md   text eol=lf
*.sql  text eol=lf
*.html text eol=lf
*.css  text eol=lf
*.sh   text eol=lf

# Binaries — no line ending conversion
*.png  binary
*.jpg  binary
*.svg  binary
*.jar  binary
*.zip  binary
